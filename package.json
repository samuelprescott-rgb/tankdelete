{
  "name": "tauri-app",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "check:campaign": "node scripts/check-campaign-brief.mjs && node scripts/check-rear-stronghold.mjs && node scripts/check-field-assault.mjs && node scripts/check-field-supplies.mjs && node scripts/check-field-session.mjs",
    "check:simulation": "node scripts/check-simulated-files.mjs",
    "check:cleanup": "node scripts/check-cleanup-desk.mjs",
    "check:arcade-shells": "node scripts/check-arcade-shells.mjs",
    "check:horde-playthrough": "node scripts/check-horde-playthrough.mjs && node scripts/check-encounter-lifecycle.mjs && node scripts/check-field-workshop.mjs",
    "check:render": "node scripts/check-render-controls.mjs",
    "check:world-gun-audio": "node scripts/check-world-gun-audio.mjs",
    "check:layout": "node scripts/check-stable-layout.mjs",
    "check:scene": "node scripts/check-scene-assets.mjs",
    "check:infantry": "node scripts/check-infantry.mjs && node scripts/check-ghost-infantry-volume.mjs",
    "check:head": "node scripts/check-authored-head.mjs",
    "check:props": "node scripts/check-supply-crates.mjs",
    "check:plants": "node scripts/check-authored-plants.mjs",
    "check:labels": "node scripts/check-file-labels.mjs",
    "check:grass": "node scripts/check-grass-lod.mjs",
    "check:composition": "node scripts/check-jungle-composition.mjs && node scripts/check-jungle-shadow-frustum.cjs",
    "check:wetlands": "node scripts/check-wetlands.mjs",
    "check:hero": "node scripts/check-hero-assets.mjs",
    "check:postprocessing": "node scripts/check-postprocessing.mjs",
    "check:encounter": "node scripts/check-encounter-lifecycle.mjs",
    "check:embassy": "node scripts/check-embassy-defense.mjs",
    "check:village": "node scripts/check-village.mjs",
    "check:aircraft": "node scripts/check-aircraft.mjs && node scripts/check-flyover-preparation.mjs",
    "check:combat-presentation": "node scripts/check-combat-presentation.mjs",
    "check:tank-drive": "node scripts/check-tank-drive.mjs && node scripts/check-tank-drive-scene.mjs",
    "check:tread-imprints": "node scripts/check-tread-imprints.mjs",
    "check:river": "node scripts/check-winding-river.mjs",
    "check:ghost-signal": "node scripts/check-ghost-slices.mjs && node scripts/check-ghost-hut-impact.mjs && node scripts/check-winding-river.mjs && node scripts/check-embassy-defense.mjs",
    "check:ghost-art": "node scripts/check-ghost-infantry-volume.mjs && node scripts/check-ghost-actor-ink.mjs && node scripts/check-hero-assets.mjs && node scripts/check-aircraft.mjs && node scripts/check-combat-presentation.mjs && node scripts/check-wetlands.mjs",
    "check:zombies": "node scripts/check-zombie-presentation.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@plackyfantacky/three.infinitegridhelper": "^1.0.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@react-three/postprocessing": "^3.0.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hot-toast": "^2.6.0",
    "three": "^0.182.0",
    "troika-three-text": "^0.52.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
